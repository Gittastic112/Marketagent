# Database
DATABASE_URL=postgresql+psycopg://marketintel:marketintel_password@localhost:5432/marketintel

# App
APP_ENV=local
APP_NAME=Market Intelligence Engine
ALERT_PRIORITY_THRESHOLD=70

# Frontend
# Server-side frontend requests use API_BASE_URL.
# Browser-side frontend requests use the same-origin proxy.
API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BROWSER_API_BASE_URL=/api/backend
NEXT_PUBLIC_DEBUG_LOGS=false

# SEC EDGAR
# Put your real contact string in .env before live SEC usage.
SEC_USER_AGENT="Market Intelligence Engine local research app contact@example.com"


# Optional AI keys, add later in .env only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional market/news data keys, add later in .env only.
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
NEWS_API_KEY=
