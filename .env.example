# Database
DATABASE_URL=postgresql+psycopg://marketintel:marketintel_password@localhost:5432/marketintel
# Supports normal Next.js server-render bursts while keeping PostgreSQL usage bounded.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=10

# App
APP_ENV=local
APP_NAME=Market Intelligence Engine
ALERT_PRIORITY_THRESHOLD=70
LOG_LEVEL=INFO
ENCRYPTION_KEY=

# Frontend
# Server-side frontend requests use API_BASE_URL.
# Browser-side frontend requests use the same-origin proxy.
API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BROWSER_API_BASE_URL=/api/backend
NEXT_PUBLIC_DEBUG_LOGS=false
CORS_ORIGINS=["http://localhost:3000"]
# Required for stable local sessions. Generate a long random value for local use.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Required to sign in locally. Do not use a shared or production password.
LOCAL_AUTH_USERNAME=
LOCAL_AUTH_PASSWORD=

# SEC EDGAR
# Put your real contact string in .env before live SEC usage.
SEC_USER_AGENT="Market Intelligence Engine local research app contact@example.com"


# Optional AI keys, add later in .env only.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Mock AI is disabled in normal use. Enable only for visibly labeled demos.
AI_DEMO_MODE=false
AI_PRIVACY_DISCLOSURE_VERSION=v1

# Implemented optional macro and market-data providers.
FRED_API_KEY=
# Supported values: alphavantage, alpha_vantage, fmp, yfinance_personal.
# yfinance_personal is explicit, unofficial, and suitable only for personal use.
MARKET_DATA_PROVIDER=alphavantage
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=

# Planned but not read by the application yet:
# TIINGO_API_KEY and UPSTOX_ANALYTICS_TOKEN.
# Add them only after their provider adapters and Docker wiring are implemented.
