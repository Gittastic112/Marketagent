# Backend builds receive only maintained code and configuration.
# Runtime datasets are mounted read-only; the knowledge corpus stays on the host.
**
!alembic.ini
!pyproject.toml
!backend/
!backend/**
!scripts/
!scripts/**
scripts/retired/**

# Apply these after the directory allowlist, including nested environments.
**/.env
**/.env.*
**/.venv*
**/venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.DS_Store
**/*.pyc
**/*.log
