{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Damodaran Knowledge Record",
  "type": "object",
  "required": [
    "id",
    "type",
    "topic",
    "rule",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "rule": {
      "type": "string"
    },
    "formula": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
